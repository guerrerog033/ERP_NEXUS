/* ==========================================================
   ERP NEXUS — Tema "Claro sobrio"

   Paleta única (no usar otros colores en el código):

     Fondo general ......... #F3F5F8
     Superficie ............ #FFFFFF
     Superficie alterna .... #F8FAFC   (hover, filas alternas)
     Borde ................. #E2E8F0
     Borde fuerte .......... #CBD5E1
     Texto ................. #1E293B
     Texto secundario ...... #64748B
     Texto tenue ........... #94A3B8
     Primario .............. #1E3A5F   (azul marino)
     Primario hover ........ #2B4C78
     Primario presionado ... #152C49
     Primario suave ........ #EAF0F7   (selección, activo)
     Primario suave borde .. #C9D6E6
     Peligro ............... #B42318   suave #FEF3F2
     Éxito ................. #067647   suave #ECFDF3
     Advertencia ........... #B54708   suave #FFFAEB
   ========================================================== */


/* ==========================================================
   Base
   ========================================================== */

QWidget{
    background-color:transparent;
    color:#1E293B;
    font-family:"Segoe UI";
    font-size:10pt;
}

/*
   Los contenedores son transparentes: así no aparecen parches
   grises dentro de las tarjetas blancas. Solo pintan fondo las
   ventanas de primer nivel y las superficies que lo declaran.
*/
QMainWindow,
QWidget#Dashboard{
    background-color:#F3F5F8;
}

QDialog,
QMessageBox,
QCalendarWidget,
QCalendarWidget QWidget,
QAbstractItemView,
QListView,
QTreeView,
QListWidget{
    background-color:#FFFFFF;
}

QCalendarWidget QToolButton{
    color:#1E293B;
    background:transparent;
    border:none;
    padding:4px 8px;
}

QCalendarWidget QAbstractItemView:enabled{
    selection-background-color:#1E3A5F;
    selection-color:#FFFFFF;
}

QLabel{
    color:#1E293B;
    background:transparent;
}

QToolTip{
    background:#1E293B;
    color:#FFFFFF;
    border:none;
    padding:6px 8px;
    border-radius:4px;
}




/* ==========================================================
   Barra superior
   ========================================================== */

QWidget#BarraSuperior{
    background-color:#FFFFFF;
    border-bottom:1px solid #E2E8F0;
}

QWidget#BarraSuperior QLabel{
    background:transparent;
}

QLabel#BarraSuperiorTitulo{
    color:#1E3A5F;
    font-size:12pt;
    font-weight:700;
    letter-spacing:0.3px;
}

QLabel#BarraSuperiorSubtitulo{
    color:#64748B;
    font-size:9pt;
    padding-right:6px;
}

QLabel#BarraSuperiorEtiqueta{
    color:#94A3B8;
    font-size:9pt;
    padding-right:4px;
}

QLabel#BarraSuperiorFecha{
    color:#1E293B;
    font-size:10pt;
    font-weight:600;
    min-width:72px;
    padding-right:10px;
    border-right:1px solid #E2E8F0;
    margin-right:4px;
}

QFrame#BarraSuperiorSeparador{
    color:#E2E8F0;
    max-width:1px;
    margin:10px 4px;
}

QLineEdit#BarraSuperiorBusqueda{
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:5px 10px;
    color:#1E293B;
    selection-background-color:#C9D6E6;
    min-height:24px;
}

QLineEdit#BarraSuperiorBusqueda:focus{
    background:#FFFFFF;
    border:1px solid #1E3A5F;
}

QToolButton#BarraSuperiorUsuario{
    background:transparent;
    border:1px solid #E2E8F0;
    border-radius:6px;
    color:#1E293B;
    font-weight:600;
    padding:4px 10px;
    min-height:26px;
}

QToolButton#BarraSuperiorUsuario:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QToolButton#BarraSuperiorUsuario::menu-indicator{
    image:none;
}

QToolButton#BarraSuperiorNotificaciones{
    background:transparent;
    border:1px solid #E2E8F0;
    border-radius:6px;
    color:#1E293B;
    padding:4px 10px;
    font-size:9pt;
}

QToolButton#BarraSuperiorNotificaciones:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QLabel#BarraSuperiorBadge{
    background:#B42318;
    color:#FFFFFF;
    border-radius:8px;
    font-size:8pt;
    font-weight:bold;
    min-width:16px;
    max-width:22px;
    min-height:16px;
    padding:0 2px;
}


/* ==========================================================
   Barra lateral
   ========================================================== */

QWidget#BarraLateral{
    background-color:#FFFFFF;
    border:none;
    border-right:1px solid #E2E8F0;
}

QScrollArea#BarraLateralScroll,
QScrollArea#BarraLateralScroll QAbstractScrollArea::viewport,
QWidget#BarraLateralContenedor{
    background-color:#FFFFFF;
    border:none;
}

QScrollArea#BarraLateralScroll QScrollBar:vertical{
    width:6px;
    background:transparent;
    margin:0;
}

QScrollArea#BarraLateralScroll QScrollBar::handle:vertical{
    background:#E2E8F0;
    border-radius:3px;
    min-height:24px;
}

QScrollArea#BarraLateralScroll QScrollBar::handle:vertical:hover{
    background:#CBD5E1;
}

QScrollArea#BarraLateralScroll QScrollBar::add-line:vertical,
QScrollArea#BarraLateralScroll QScrollBar::sub-line:vertical,
QScrollArea#BarraLateralScroll QScrollBar::add-page:vertical,
QScrollArea#BarraLateralScroll QScrollBar::sub-page:vertical{
    height:0;
    background:transparent;
}

QPushButton#BarraLateralToggle{
    background:#FFFFFF;
    color:#64748B;
    border:none;
    border-top:1px solid #E2E8F0;
    border-radius:0;
    padding:8px;
    font-weight:600;
    min-height:30px;
}

QPushButton#BarraLateralToggle:hover{
    background:#F8FAFC;
    color:#1E3A5F;
}

QLabel#BarraLateralEtiqueta{
    color:#94A3B8;
    font-size:8pt;
    font-weight:700;
    letter-spacing:0.8px;
    padding:16px 18px 6px 18px;
    background:transparent;
}

QFrame#BarraLateralSeparador{
    color:#E2E8F0;
    margin:6px 14px;
    max-height:1px;
}

QFrame#BotonModulo,
QFrame#BotonModuloPendiente{
    background:transparent;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QFrame#BotonModulo:hover{
    background-color:#F8FAFC;
}

QFrame#BotonModuloPendiente:hover{
    background-color:#F8FAFC;
}

QFrame#BotonModuloActivo{
    background-color:#EAF0F7;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QLabel#BotonModuloTitulo{
    color:#334155;
    font-size:10pt;
    background:transparent;
}

QFrame#BotonModuloActivo QLabel#BotonModuloTitulo{
    color:#1E3A5F;
    font-weight:600;
}

QFrame#BotonModuloPendiente QLabel#BotonModuloTitulo{
    color:#94A3B8;
}

QLabel#BotonModuloIcono{
    background:transparent;
    min-width:20px;
    min-height:20px;
}

QLabel#BotonModuloFlecha{
    color:#94A3B8;
    background:transparent;
    font-size:9pt;
}

QFrame#BotonModuloActivo QLabel#BotonModuloFlecha{
    color:#1E3A5F;
}

QWidget#BarraLateralSubmenu{
    background:transparent;
    margin:2px 0 6px 0;
}

QFrame#BotonSubmodulo,
QFrame#BotonSubmoduloActivo{
    background:transparent;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QFrame#BotonSubmodulo:hover{
    background-color:#F8FAFC;
}

QLabel#BotonSubmoduloTitulo{
    color:#64748B;
    font-size:9.5pt;
    background:transparent;
}

QFrame#BotonSubmodulo:hover QLabel#BotonSubmoduloTitulo{
    color:#1E293B;
}

QFrame#BotonSubmoduloActivo QLabel#BotonSubmoduloTitulo{
    color:#1E3A5F;
    font-weight:600;
}


/* ==========================================================
   Buscador de módulos (Ctrl+K)
   ========================================================== */

QDialog#BuscadorModulos{
    background-color:#FFFFFF;
}

QLineEdit#BuscadorModulosEntrada{
    background:#FFFFFF;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:8px 12px;
    font-size:10pt;
    min-height:22px;
}

QLineEdit#BuscadorModulosEntrada:focus{
    border:1px solid #1E3A5F;
}

QLabel#BuscadorModulosAyuda{
    color:#64748B;
    font-size:9pt;
    background:transparent;
}

QListWidget#BuscadorModulosLista{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:4px;
    font-size:10pt;
}

QListWidget#BuscadorModulosLista::item{
    padding:8px 10px;
    border-radius:4px;
}

QListWidget#BuscadorModulosLista::item:selected{
    background-color:#EAF0F7;
    color:#1E3A5F;
}

QListWidget#BuscadorModulosLista::item:hover{
    background-color:#F8FAFC;
}


/* ==========================================================
   Área de trabajo (pestañas)
   ========================================================== */

QTabWidget#AreaTrabajo{
    background-color:#F3F5F8;
}

QTabWidget#AreaTrabajo::pane{
    border:none;
    border-top:1px solid #E2E8F0;
    background-color:#F3F5F8;
    top:-1px;
}

QTabWidget#AreaTrabajo::tab-bar{
    alignment:left;
}

QTabWidget#AreaTrabajo QTabBar{
    background:#FFFFFF;
}

QTabWidget#AreaTrabajo QTabBar::tab{
    background:#FFFFFF;
    border:none;
    border-bottom:2px solid transparent;
    padding:9px 30px 9px 14px;
    margin-right:0;
    min-width:88px;
    color:#64748B;
}

QTabWidget#AreaTrabajo QTabBar::tab:selected{
    color:#1E3A5F;
    font-weight:600;
    border-bottom:2px solid #1E3A5F;
}

QTabWidget#AreaTrabajo QTabBar::tab:hover{
    color:#1E293B;
    background:#F8FAFC;
}

QTabWidget#AreaTrabajo QTabBar::close-button{
    subcontrol-origin:padding;
    subcontrol-position:right;
    width:16px;
    height:16px;
    margin:2px 8px 2px 4px;
    border-radius:3px;
    background:transparent;
}

QTabWidget#AreaTrabajo QTabBar::close-button:hover{
    background:#FEF3F2;
}


/* ==========================================================
   Inicio
   ========================================================== */

QWidget#Inicio{
    background-color:#F3F5F8;
}

QFrame#PanelInicio{
    background-color:#F3F5F8;
    border:none;
}

QLabel#InicioTitulo{
    font-size:18pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#InicioSubtitulo{
    font-size:10pt;
    color:#64748B;
}

QFrame#TarjetaInicio{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    padding:12px;
}

QFrame#TarjetaInicio:hover{
    border-color:#CBD5E1;
}

QLabel#TarjetaInicioTitulo{
    color:#64748B;
    font-size:9pt;
    font-weight:600;
}

QLabel#TarjetaInicioValor{
    font-size:18pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#TarjetaInicioDetalle{
    color:#94A3B8;
    font-size:9pt;
}

QLabel#InicioSeccionTitulo{
    color:#1E293B;
    font-size:10.5pt;
    font-weight:700;
    padding-top:6px;
}

QPushButton#BotonAccesoRapido{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:8px 16px;
    font-weight:600;
    min-height:20px;
}

QPushButton#BotonAccesoRapido:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
    color:#1E3A5F;
}

QFrame#InicioListaRecientes{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QPushButton#InicioFilaReciente{
    background:transparent;
    color:#1E293B;
    border:none;
    border-bottom:1px solid #F1F5F9;
    border-radius:0;
    padding:10px 14px;
    text-align:left;
    font-weight:400;
}

QPushButton#InicioFilaReciente:hover{
    background:#F8FAFC;
}

QPushButton#InicioFilaReciente:last-child{
    border-bottom:none;
}

QLabel#InicioListaVacia{
    color:#94A3B8;
    font-size:9pt;
    padding:12px 14px;
}

QScrollArea#InicioScroll{
    background:transparent;
    border:none;
}


/* ==========================================================
   Páginas de módulo
   ========================================================== */

QWidget#PaginaModulo{
    background:transparent;
}

QFrame#PanelModulo{
    background-color:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QLabel#PaginaModuloTitulo{
    font-size:16pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#PaginaModuloSubtitulo{
    font-size:10pt;
    color:#64748B;
}


/* ==========================================================
   Barra inferior y barra de estado
   ========================================================== */

QWidget#BarraInferior{
    background:#FFFFFF;
    border-top:1px solid #E2E8F0;
}

QFrame#BarraInferiorSeparador{
    color:#E2E8F0;
    max-width:1px;
}

QPushButton#BotonRapido{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:6px 12px;
    font-weight:600;
    color:#1E293B;
    min-height:20px;
}

QPushButton#BotonRapido:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QPushButton#BotonRapidoDestacado{
    background:#1E3A5F;
    border:1px solid #1E3A5F;
    border-radius:6px;
    padding:6px 14px;
    font-weight:600;
    color:#FFFFFF;
    min-height:22px;
}

QPushButton#BotonRapidoDestacado:hover{
    background:#2B4C78;
}

QWidget#BarraEstado{
    background-color:#FFFFFF;
    border-top:1px solid #E2E8F0;
}

QWidget#BarraEstado QLabel,
QLabel#BarraEstadoTexto{
    color:#64748B;
    font-size:9pt;
    background:transparent;
}

QLabel#BarraEstadoTextoDestacado{
    color:#1E293B;
    font-weight:600;
}


/* ==========================================================
   Maestros — toolbar y grilla
   ========================================================== */

QWidget#ToolbarAcciones{
    background:transparent;
    border:none;
    padding:0;
}

QWidget#DataGrid{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QWidget#DataGridToolbar{
    background:#FFFFFF;
    border:none;
    border-bottom:1px solid #E2E8F0;
    padding:2px 4px;
}

QLabel#DataGridTotal{
    color:#64748B;
    font-size:9pt;
    padding:2px 4px;
}

QWidget#LoadingOverlay{
    background:rgba(243,245,248,0.82);
    border:none;
}

QLabel#LoadingOverlayText{
    color:#1E293B;
    font-size:11pt;
    font-weight:600;
    padding:12px 20px;
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QToolButton#MaestroToolbarMas{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:6px 12px;
    font-weight:600;
}

QToolButton#MaestroToolbarMas:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QToolButton#MaestroToolbarMas::menu-indicator{
    image:none;
}

QWidget#Page{
    background:transparent;
}


/* ==========================================================
   Login
   ========================================================== */

QWidget#Login,
QWidget#LoginContenedor,
QWidget#LoginMarcaPanel,
QStackedWidget,
QStackedWidget#StackPrincipal {
    background: transparent;
}

QFrame#LoginPanel{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:14px;
}

QFrame#LoginPanelCabecera{
    background:#1E3A5F;
    border-top-left-radius:13px;
    border-top-right-radius:13px;
}

QLabel#LoginSubtitulo{
    color:#FFFFFF;
    background:transparent;
    font-size:15pt;
    font-weight:700;
}

QLabel#LoginCabeceraDetalle{
    color:rgba(255,255,255,0.78);
    background:transparent;
    font-size:9pt;
}

QLabel#LoginModuloChip{
    background:#EAF0F7;
    color:#1E3A5F;
    border:1px solid #C9D6E6;
    border-radius:10px;
    padding:4px 8px;
    font-size:8pt;
    font-weight:600;
}

QLabel#LoginMarcaTitulo{
    color:#FFFFFF;
    background:transparent;
    font-size:42px;
    font-weight:700;
}

QLabel#LoginMarcaTexto{
    color:rgba(255,255,255,0.85);
    background:transparent;
    font-size:13pt;
}

QLabel#LoginDestacadoMarca{
    color:#FFFFFF;
    background:rgba(255,255,255,0.10);
    border:1px solid rgba(255,255,255,0.25);
    border-radius:10px;
    padding:4px 10px;
    font-size:8pt;
    font-weight:600;
}


/* ==========================================================
   Formularios
   ========================================================== */

QGroupBox{
    font-weight:600;
    border:1px solid #E2E8F0;
    border-radius:8px;
    margin-top:14px;
    padding-top:14px;
    background:#FFFFFF;
}

QGroupBox#FormGroupBox{
    font-size:10.5pt;
    font-weight:600;
    border:1px solid #E2E8F0;
    border-radius:8px;
    margin-top:14px;
    padding-top:16px;
    background:#FFFFFF;
}

QGroupBox::title{
    subcontrol-origin:margin;
    left:12px;
    padding-left:4px;
    padding-right:4px;
    color:#1E293B;
}

QGroupBox#FormGroupBox::title{
    left:14px;
    padding:0px 4px;
}

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:5px 8px;
    selection-background-color:#C9D6E6;
    selection-color:#1E293B;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover{
    border-color:#94A3B8;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus{
    border:1px solid #1E3A5F;
}

QLineEdit:read-only{
    background:#F8FAFC;
    color:#475569;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled{
    background:#F8FAFC;
    color:#94A3B8;
    border-color:#E2E8F0;
}

QComboBox QAbstractItemView{
    background:#FFFFFF;
    border:1px solid #CBD5E1;
    selection-background-color:#EAF0F7;
    selection-color:#1E3A5F;
    outline:none;
}

QCheckBox{
    background:transparent;
    spacing:8px;
}

QLabel#CampoErrorLabel{
    color:#B42318;
    font-size:9pt;
    padding-left:2px;
}

QLineEdit[invalid="true"],
QComboBox[invalid="true"],
QSpinBox[invalid="true"],
QDoubleSpinBox[invalid="true"]{
    border:1px solid #B42318;
    background:#FEF3F2;
}


/* ==========================================================
   Botones

   Por defecto un botón es secundario (blanco con borde).
   Solo la acción principal de cada pantalla es azul marino
   (#BotonPrimario) y las destructivas van en rojo suave.
   ========================================================== */

QPushButton{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QPushButton:pressed{
    background:#F1F5F9;
}

QPushButton:disabled{
    background:#F8FAFC;
    color:#94A3B8;
    border-color:#E2E8F0;
}

QPushButton#BotonPrimario{
    background:#1E3A5F;
    color:#FFFFFF;
    border:1px solid #1E3A5F;
    border-radius:6px;
    padding:7px 18px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonPrimario:hover{
    background:#2B4C78;
    border-color:#2B4C78;
}

QPushButton#BotonPrimario:pressed{
    background:#152C49;
}

QPushButton#BotonPrimario:disabled{
    background:#CBD5E1;
    border-color:#CBD5E1;
    color:#FFFFFF;
}

QPushButton#BotonSecundario{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonSecundario:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QPushButton#BotonSecundario:pressed{
    background:#F1F5F9;
}

QPushButton#BotonPeligro{
    background:#FFFFFF;
    color:#B42318;
    border:1px solid #F3C9C4;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonPeligro:hover{
    background:#FEF3F2;
    border-color:#B42318;
}

QPushButton#BotonPeligro:pressed{
    background:#FEE4E2;
}


/* ==========================================================
   Vista de documento (facturas, cotizaciones, pedidos...)
   ========================================================== */

QLabel#DocumentoTitulo{
    color:#1E293B;
    font-size:13pt;
    font-weight:700;
}

QLabel#BarraAccionEtiqueta{
    color:#64748B;
    font-weight:600;
}

QLabel#DocumentoFormatoChip{
    color:#64748B;
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:11px;
    padding:3px 12px;
    font-size:9pt;
}

QLabel#DocumentoBadge{
    background:#F8FAFC;
    color:#475569;
    border:1px solid #E2E8F0;
    border-radius:11px;
    padding:3px 12px;
    font-size:9pt;
    font-weight:600;
}

QLabel#DocumentoBadge[tono="info"]{
    background:#EAF0F7;
    color:#1E3A5F;
    border:1px solid #C9D6E6;
}

QLabel#DocumentoBadge[tono="exito"]{
    background:#ECFDF3;
    color:#067647;
    border:1px solid #ABEFC6;
}

QLabel#DocumentoBadge[tono="advertencia"]{
    background:#FFFAEB;
    color:#B54708;
    border:1px solid #FEDF89;
}

QLabel#DocumentoBadge[tono="peligro"]{
    background:#FEF3F2;
    color:#B42318;
    border:1px solid #FECDCA;
}

QFrame#DocumentoPreviewMarco{
    background:#F3F5F8;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QTextBrowser#DocumentoPreviewHtml{
    background:#FFFFFF;
    border-radius:6px;
    padding:8px;
}


/* ==========================================================
   Tablas
   ========================================================== */

QTableWidget,
QTableView{
    background:#FFFFFF;
    alternate-background-color:#F8FAFC;
    gridline-color:#F1F5F9;
    border:1px solid #E2E8F0;
    border-radius:6px;
    selection-background-color:#EAF0F7;
    selection-color:#1E293B;
    outline:none;
}

QTableWidget::item,
QTableView::item{
    padding:4px 6px;
    border:none;
}

QTableWidget::item:selected,
QTableView::item:selected{
    background:#EAF0F7;
    color:#1E293B;
}

QHeaderView{
    background:#F8FAFC;
    border:none;
}

QHeaderView::section{
    background:#F8FAFC;
    color:#475569;
    padding:8px 6px;
    border:none;
    border-bottom:1px solid #E2E8F0;
    border-right:1px solid #F1F5F9;
    font-weight:600;
}

QTableCornerButton::section{
    background:#F8FAFC;
    border:none;
    border-bottom:1px solid #E2E8F0;
}


/* ==========================================================
   Barras de desplazamiento (generales)
   ========================================================== */

QScrollBar:vertical{
    width:10px;
    background:transparent;
    margin:2px;
}

QScrollBar::handle:vertical{
    background:#CBD5E1;
    border-radius:3px;
    min-height:28px;
}

QScrollBar::handle:vertical:hover{
    background:#94A3B8;
}

QScrollBar:horizontal{
    height:10px;
    background:transparent;
    margin:2px;
}

QScrollBar::handle:horizontal{
    background:#CBD5E1;
    border-radius:3px;
    min-width:28px;
}

QScrollBar::handle:horizontal:hover{
    background:#94A3B8;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page{
    width:0;
    height:0;
    background:transparent;
}

QScrollArea{
    background:transparent;
    border:none;
}

QWidget#FormularioPage{
    background:transparent;
}


/* ==========================================================
   Menús y diálogos
   ========================================================== */

QMenu{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:4px;
}

QMenu::item{
    padding:6px 18px;
    border-radius:4px;
    background:transparent;
}

QMenu::item:selected{
    background:#EAF0F7;
    color:#1E3A5F;
}

QMenu::separator{
    height:1px;
    background:#E2E8F0;
    margin:4px 6px;
}

QDialog{
    background:#FFFFFF;
}

QMessageBox{
    background:#FFFFFF;
}


/* ==========================================================
   Contabilidad
   ========================================================== */

QWidget#HubContabilidad{
    background:#F3F5F8;
}

QTabWidget::pane{
    border:1px solid #E2E8F0;
    background:#FFFFFF;
    border-radius:6px;
}

QTabBar::tab{
    background:transparent;
    color:#64748B;
    border:none;
    border-bottom:2px solid transparent;
    padding:8px 16px;
}

QTabBar::tab:selected{
    color:#1E3A5F;
    font-weight:600;
    border-bottom:2px solid #1E3A5F;
}

QTabBar::tab:hover{
    color:#1E293B;
}

QTabWidget#ContabilidadTabs::pane{
    border:1px solid #E2E8F0;
    background:#F3F5F8;
    border-radius:0 0 6px 6px;
}

QTabWidget#ContabilidadTabs QTabBar::tab{
    background:transparent;
    color:#64748B;
    border:none;
    border-bottom:2px solid transparent;
    padding:8px 18px;
    margin-right:2px;
    font-weight:600;
}

QTabWidget#ContabilidadTabs QTabBar::tab:selected{
    color:#1E3A5F;
    border-bottom:2px solid #1E3A5F;
}

QFrame#TarjetaProcesoContabilidad{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    min-height:180px;
}

QLabel#TarjetaProcesoContabilidadTitulo{
    color:#1E293B;
    font-size:11pt;
    font-weight:700;
    padding-bottom:4px;
}

QPushButton#EnlaceProcesoContabilidad{
    background:transparent;
    color:#334155;
    border:none;
    text-align:left;
    padding:4px 2px;
    font-size:10pt;
    font-weight:400;
}

QPushButton#EnlaceProcesoContabilidad:hover{
    color:#1E3A5F;
    text-decoration:underline;
}


/* ==========================================================
   Panel gerencial
   ========================================================== */

QWidget#PanelGerencialPage{
    background:#F3F5F8;
}

QLabel#PanelGerencialEmpresa{
    color:#1E293B;
    font-size:12pt;
    font-weight:600;
}

QFrame#PanelGerencialKpi{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    min-height:96px;
}

QFrame#PanelGerencialKpi:hover{
    border-color:#CBD5E1;
}

QLabel#PanelGerencialKpiTitulo{
    color:#64748B;
    font-size:10pt;
    font-weight:600;
}

QLabel#PanelGerencialKpiValor{
    color:#1E293B;
    font-size:16pt;
    font-weight:700;
}

QLabel#PanelGerencialKpiDetalle{
    color:#64748B;
    font-size:9pt;
}

QFrame#PanelGerencialEmbudo{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    padding:8px;
}

QLabel#PanelGerencialEmbudoTitulo{
    color:#1E293B;
    font-size:11pt;
    font-weight:700;
    padding-bottom:6px;
}

QProgressBar#PanelGerencialEmbudoBarra{
    border:1px solid #E2E8F0;
    border-radius:4px;
    text-align:left;
    padding-left:8px;
    background:#F8FAFC;
    color:#1E293B;
    min-height:22px;
}

QProgressBar#PanelGerencialEmbudoBarra::chunk{
    background:#1E3A5F;
    border-radius:3px;
}


/* ==========================================================
   Contenedor principal tras iniciar sesión
   ========================================================== */

QWidget#Dashboard{
    background-color:#F3F5F8;
}


/* ==========================================================
   Hoja de documento (cotización, pedido, remisión, factura...)
   ========================================================== */

QLabel#DocumentoTituloHoja{
    color:#1E293B;
    font-size:17pt;
    font-weight:700;
    padding:0 0 6px 0;
    border:none;
}

QFrame#DocumentoSeparador{
    color:#E2E8F0;
    background:#E2E8F0;
    max-height:1px;
    border:none;
}

QLabel#DocumentoEtiquetaSeccion{
    color:#1E293B;
    font-weight:600;
}

QPushButton#BotonAgregarLinea{
    background:transparent;
    color:#1E3A5F;
    border:1px dashed #C9D6E6;
    border-radius:6px;
    padding:7px 14px;
    font-weight:600;
}

QPushButton#BotonAgregarLinea:hover{
    background:#EAF0F7;
    border-color:#1E3A5F;
}

QWidget#PanelTotalesDocumento{
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QWidget#PanelTotalesDocumento QLabel{
    color:#475569;
}

QLabel#DocumentoTotal{
    color:#1E293B;
    font-size:13pt;
    font-weight:700;
    padding-top:6px;
    border-top:1px solid #E2E8F0;
}


/* ==========================================================
   Flechas de combos, fechas y números
   ========================================================== */

QComboBox,
QDateEdit{
    padding-right:24px;
}

QComboBox::drop-down,
QDateEdit::drop-down{
    subcontrol-origin:padding;
    subcontrol-position:center right;
    width:22px;
    border:none;
    background:transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow{
    image:url({ICONOS}/flecha_abajo.svg);
    width:12px;
    height:12px;
}

QComboBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled{
    image:none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button{
    subcontrol-origin:border;
    subcontrol-position:top right;
    width:18px;
    border:none;
    background:transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button{
    subcontrol-origin:border;
    subcontrol-position:bottom right;
    width:18px;
    border:none;
    background:transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow{
    image:url({ICONOS}/flecha_arriba.svg);
    width:10px;
    height:10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow{
    image:url({ICONOS}/flecha_abajo.svg);
    width:10px;
    height:10px;
}


/* ==========================================================
   Casillas de verificación y opciones
   ========================================================== */

QCheckBox::indicator,
QTableView::indicator,
QTableWidget::indicator{
    width:16px;
    height:16px;
    border:1px solid #94A3B8;
    border-radius:4px;
    background:#FFFFFF;
}

QCheckBox::indicator:hover{
    border-color:#1E3A5F;
}

QCheckBox::indicator:checked,
QTableView::indicator:checked,
QTableWidget::indicator:checked{
    background:#1E3A5F;
    border-color:#1E3A5F;
    image:url({ICONOS}/check.svg);
}

QCheckBox::indicator:disabled{
    background:#F1F5F9;
    border-color:#CBD5E1;
}

QRadioButton::indicator{
    width:16px;
    height:16px;
    border:1px solid #94A3B8;
    border-radius:8px;
    background:#FFFFFF;
}

QRadioButton::indicator:checked{
    border:5px solid #1E3A5F;
    background:#FFFFFF;
}


QPushButton#BotonEnlace{
    background:transparent;
    border:none;
    color:#1E3A5F;
    font-weight:600;
    padding:2px 0;
    text-align:left;
}

QPushButton#BotonEnlace:hover{
    color:#2B4C78;
    text-decoration:underline;
}


QPushButton#BotonQuitarFila{
    background:transparent;
    color:#B42318;
    border:1px solid transparent;
    border-radius:6px;
    padding:0;
    min-height:0;
    font-weight:600;
}

QPushButton#BotonQuitarFila:hover{
    background:#FEF3F2;
    border-color:#FECDCA;
}


/* ==========================================================
   ESTILO ESCRITORIO — "Gris acero"
   (va al final: reemplaza lo anterior con igual especificidad)

     Fondo ventana .... #D9DEE5     Paneles ......... #E8ECF1
     Panel interno .... #F2F4F7     Encabezados ..... #C9D2DD
     Bordes ........... #B8C2CE     Borde suave ..... #C9D2DD
     Barra lateral .... #2B3A4E     Campos/tablas ... #FFFFFF
     Acento ........... #1E3A5F
   Esquinas casi rectas (3px), menos relleno, controles compactos.
   ========================================================== */

QMainWindow,
QWidget#Dashboard,
QWidget#Inicio,
QTabWidget#AreaTrabajo,
QTabWidget#AreaTrabajo::pane,
QFrame#PanelInicio,
QWidget#HubContabilidad,
QWidget#PanelGerencialPage{
    background-color:#D9DEE5;
}

QWidget{
    font-size:9.5pt;
}

/* ---------- Barra superior y de estado ---------- */

QWidget#BarraSuperior{
    background-color:#E8ECF1;
    border-bottom:1px solid #B8C2CE;
}

QLineEdit#BarraSuperiorBusqueda{
    background:#FFFFFF;
    border:1px solid #B8C2CE;
    border-radius:3px;
}

QToolButton#BarraSuperiorUsuario,
QToolButton#BarraSuperiorNotificaciones{
    border:1px solid #B8C2CE;
    border-radius:3px;
    background:#F2F4F7;
}

QWidget#BarraEstado{
    background-color:#C9D2DD;
    border-top:1px solid #B8C2CE;
}

QWidget#BarraEstado QLabel,
QLabel#BarraEstadoTexto{
    color:#334155;
}

/* ---------- Barra lateral oscura ---------- */

QWidget#BarraLateral,
QScrollArea#BarraLateralScroll,
QScrollArea#BarraLateralScroll QAbstractScrollArea::viewport,
QWidget#BarraLateralContenedor{
    background-color:#2B3A4E;
    border:none;
}

QLabel#BarraLateralEtiqueta{
    color:#8FA0B5;
    padding:14px 16px 4px 16px;
}

QFrame#BotonModulo,
QFrame#BotonModuloPendiente,
QFrame#BotonModuloActivo{
    border-radius:3px;
    margin:0 6px;
}

QFrame#BotonModulo:hover,
QFrame#BotonModuloPendiente:hover{
    background-color:#34465D;
}

QFrame#BotonModuloActivo{
    background-color:#3D5574;
}

QLabel#BotonModuloTitulo{
    color:#DCE3EC;
}

QFrame#BotonModuloActivo QLabel#BotonModuloTitulo{
    color:#FFFFFF;
}

QLabel#BotonModuloFlecha,
QFrame#BotonModuloActivo QLabel#BotonModuloFlecha{
    color:#8FA0B5;
}

QFrame#BotonSubmodulo,
QFrame#BotonSubmoduloActivo{
    border-radius:3px;
    margin:0 6px;
}

QFrame#BotonSubmodulo:hover{
    background-color:#34465D;
}

QFrame#BotonSubmoduloActivo{
    background-color:#22303F;
}

QLabel#BotonSubmoduloTitulo{
    color:#B4C0CF;
}

QFrame#BotonSubmodulo:hover QLabel#BotonSubmoduloTitulo,
QFrame#BotonSubmoduloActivo QLabel#BotonSubmoduloTitulo{
    color:#FFFFFF;
}

QPushButton#BarraLateralToggle{
    background:#22303F;
    color:#B4C0CF;
    border-top:1px solid #1B2633;
}

QPushButton#BarraLateralToggle:hover{
    background:#34465D;
    color:#FFFFFF;
}

QScrollArea#BarraLateralScroll QScrollBar::handle:vertical{
    background:#46586F;
}

/* ---------- Pestañas clásicas ---------- */

QTabWidget#AreaTrabajo QTabBar{
    background:#D9DEE5;
}

QTabWidget#AreaTrabajo QTabBar::tab{
    background:#C9D2DD;
    color:#334155;
    border:1px solid #B8C2CE;
    border-bottom:none;
    border-top-left-radius:3px;
    border-top-right-radius:3px;
    padding:5px 28px 5px 12px;
    margin:4px 2px 0 0;
}

QTabWidget#AreaTrabajo QTabBar::tab:selected{
    background:#E8ECF1;
    color:#1E3A5F;
    font-weight:600;
    border-bottom:none;
    margin-top:2px;
}

QTabWidget#AreaTrabajo QTabBar::tab:hover{
    background:#D3DAE3;
}

QTabWidget#AreaTrabajo::pane{
    border-top:1px solid #B8C2CE;
}

/* ---------- Paneles y tarjetas ---------- */

QFrame#card{
    background:#E8ECF1;
    border:1px solid #B8C2CE;
    border-radius:4px;
}

QFrame#TarjetaInicio,
QFrame#PanelModulo,
QWidget#DataGrid,
QFrame#InicioListaRecientes,
QFrame#TarjetaProcesoContabilidad,
QFrame#PanelGerencialKpi,
QFrame#PanelGerencialEmbudo{
    background:#E8ECF1;
    border:1px solid #B8C2CE;
    border-radius:4px;
}

QGroupBox,
QGroupBox#FormGroupBox{
    background:#F2F4F7;
    border:1px solid #C3CCD8;
    border-radius:3px;
    margin-top:12px;
    padding-top:12px;
}

QWidget#PanelTotalesDocumento{
    background:#F2F4F7;
    border:1px solid #C3CCD8;
    border-radius:3px;
}

QLabel#DocumentoTituloHoja{
    font-size:13pt;
    padding:0 0 2px 0;
}

QLabel#InicioTitulo{
    font-size:15pt;
}

QLabel#TarjetaInicioValor{
    font-size:15pt;
}

QDialog,
QMessageBox{
    background-color:#E8ECF1;
}

/* ---------- Controles compactos ---------- */

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit{
    border:1px solid #AEB8C5;
    border-radius:2px;
    padding:3px 6px;
    background:#FFFFFF;
}

QComboBox,
QDateEdit{
    padding-right:22px;
}

QLineEdit:read-only,
QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled{
    background:#EEF1F5;
}

QPushButton,
QPushButton#BotonSecundario,
QToolButton#MaestroToolbarMas,
QPushButton#BotonAccesoRapido,
QPushButton#BotonRapido{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FAFBFC, stop:1 #E3E8EE);
    color:#1E293B;
    border:1px solid #AEB8C5;
    border-radius:3px;
    padding:4px 12px;
    min-height:20px;
}

QPushButton:hover,
QPushButton#BotonSecundario:hover,
QToolButton#MaestroToolbarMas:hover,
QPushButton#BotonAccesoRapido:hover,
QPushButton#BotonRapido:hover{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #EAF0F7);
    border-color:#7D8DA1;
}

QPushButton:pressed,
QPushButton#BotonSecundario:pressed{
    background:#D6DDE6;
}

QPushButton:disabled{
    background:#E6EAEF;
    color:#94A3B8;
    border-color:#C9D2DD;
}

QPushButton#BotonPrimario,
QPushButton#BotonRapidoDestacado{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2B4C78, stop:1 #1E3A5F);
    color:#FFFFFF;
    border:1px solid #152C49;
    border-radius:3px;
    padding:4px 14px;
    min-height:20px;
}

QPushButton#BotonPrimario:hover,
QPushButton#BotonRapidoDestacado:hover{
    background:#2B4C78;
}

QPushButton#BotonPeligro{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FAFBFC, stop:1 #E3E8EE);
    color:#B42318;
    border:1px solid #D9A39D;
    border-radius:3px;
    padding:4px 12px;
    min-height:20px;
}

QPushButton#BotonPeligro:hover{
    background:#FEF3F2;
    border-color:#B42318;
}

QPushButton#BotonAgregarLinea{
    background:transparent;
    border:1px dashed #9AA8BA;
    border-radius:3px;
    padding:4px 12px;
}

QPushButton#BotonQuitarFila,
QPushButton#BotonEnlace{
    background:transparent;
    border:none;
}

/* ---------- Tablas con rejilla ---------- */

QTableWidget,
QTableView{
    background:#FFFFFF;
    alternate-background-color:#EAEFF5;
    gridline-color:#D5DCE4;
    border:1px solid #AEB8C5;
    border-radius:2px;
}

QHeaderView,
QHeaderView::section,
QTableCornerButton::section{
    background:#C9D2DD;
    color:#1E293B;
}

QHeaderView::section{
    padding:5px 6px;
    border:none;
    border-right:1px solid #B8C2CE;
    border-bottom:1px solid #AEB8C5;
    font-weight:600;
}

QTableWidget::item:selected,
QTableView::item:selected{
    background:#3A6EA5;
    color:#FFFFFF;
}

/* ---------- Menús ---------- */

QMenu{
    background:#F2F4F7;
    border:1px solid #AEB8C5;
    border-radius:2px;
}

QMenu::item:selected{
    background:#C9D9EC;
}

/* ==========================================================
   VENTANA DE ESCRITORIO — lo mejor de Siigo Pyme, Sysplus,
   World Office y Magister
   (menú clásico, barra de herramientas con íconos, barra de
   teclas de función, barra de estado por celdas, encabezados
   de módulo con color, listas con "Buscar por" y navegador)
   ========================================================== */

/* ---------- Barra de menú (Archivo, Comercial…) ---------- */

QMenuBar#BarraMenu{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F4F6F9, stop:1 #E3E8EE);
    border-bottom:1px solid #C3CCD8;
    padding:1px 4px;
    color:#1E293B;
}

QMenuBar#BarraMenu::item{
    background:transparent;
    padding:3px 10px;
    border-radius:2px;
}

QMenuBar#BarraMenu::item:selected{
    background:#C9D9EC;
    color:#0F2740;
}

QMenuBar#BarraMenu::item:pressed{
    background:#1E3A5F;
    color:#FFFFFF;
}

QMenu{
    padding:3px 0;
}

QMenu::item{
    padding:5px 28px 5px 26px;
    color:#1E293B;
}

QMenu::item:selected{
    background:#3A6EA5;
    color:#FFFFFF;
}

QMenu::item:disabled{
    color:#7B8794;
}

QMenu::separator{
    height:1px;
    background:#C3CCD8;
    margin:3px 8px;
}

QMenu::icon{
    padding-left:6px;
}

/* ---------- Cabecera: herramientas + sesión ---------- */

QWidget#BarraSuperior{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #EEF1F5, stop:1 #D8DEE6);
    border-bottom:1px solid #AEB8C5;
}

QToolButton#BotonHerramienta{
    background:transparent;
    border:1px solid transparent;
    border-radius:3px;
    color:#1E293B;
    font-size:8.5pt;
    padding:2px 6px 1px 6px;
    min-width:54px;
}

QToolButton#BotonHerramienta:hover{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:1 #E4EBF3);
    border:1px solid #A9B7C8;
}

QToolButton#BotonHerramienta:pressed{
    background:#C9D9EC;
    border:1px solid #8EA2BA;
}

QFrame#BarraHerramientasSeparador,
QFrame#ToolbarSeparador{
    background:#B8C2CE;
    border:none;
    margin:0 4px;
}

QFrame#PanelSesion{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2E4460, stop:1 #1E3A5F);
    border:1px solid #16293F;
    border-radius:4px;
}

QFrame#PanelSesion QLabel#BarraSuperiorTitulo{
    color:#FFFFFF;
    font-size:11pt;
    letter-spacing:0.5px;
}

QFrame#PanelSesion QLabel#BarraSuperiorEtiqueta{
    color:#AFC0D4;
    font-size:8.5pt;
}

QFrame#PanelSesion QLabel#BarraSuperiorFecha{
    color:#FFFFFF;
    font-size:8.5pt;
    font-weight:600;
}

QFrame#PanelSesion QToolButton#BarraSuperiorUsuario,
QFrame#PanelSesion QToolButton#BarraSuperiorNotificaciones{
    background:rgba(255,255,255,0.10);
    border:1px solid rgba(255,255,255,0.22);
    border-radius:3px;
    color:#FFFFFF;
    padding:2px 8px;
}

QFrame#PanelSesion QToolButton#BarraSuperiorUsuario:hover,
QFrame#PanelSesion QToolButton#BarraSuperiorNotificaciones:hover{
    background:rgba(255,255,255,0.20);
}

QFrame#PanelSesion QLineEdit#BarraSuperiorBusqueda{
    background:#FFFFFF;
    border:1px solid #16293F;
    border-radius:3px;
    padding:2px 6px;
    min-height:20px;
    color:#1E293B;
}

/* ---------- Barra de teclas de función ---------- */

QWidget#BarraTeclas{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E3E8EE, stop:1 #CCD4DE);
    border-top:1px solid #AEB8C5;
}

QPushButton#BotonTecla{
    background:transparent;
    border:1px solid transparent;
    border-radius:3px;
    min-height:22px;
    max-height:22px;
    padding:0;
}

QPushButton#BotonTecla:hover{
    background:#F4F6F9;
    border:1px solid #A9B7C8;
}

QPushButton#BotonTecla:pressed{
    background:#C9D9EC;
}

QPushButton#BotonTecla:disabled QLabel{
    color:#8A96A3;
}

QLabel#TeclaTapa{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:1 #E2E7EE);
    border:1px solid #9AA8BA;
    border-bottom:2px solid #8392A6;
    border-radius:3px;
    color:#1E3A5F;
    font-size:8pt;
    font-weight:700;
    padding:0 5px;
    min-width:18px;
}

QLabel#TeclaTexto{
    color:#1E293B;
    font-size:8.5pt;
}

/* ---------- Barra de estado por celdas (Magister) ---------- */

QWidget#BarraEstado{
    background:#D5DCE5;
    border-top:1px solid #AEB8C5;
}

QFrame#BarraEstadoCelda{
    border:none;
    border-left:1px solid #B3BECB;
}

QWidget#BarraEstado QLabel,
QLabel#BarraEstadoTexto{
    color:#334155;
    font-size:8.5pt;
}

QLabel#BarraEstadoTextoDestacado{
    color:#1E3A5F;
    font-size:8.5pt;
    font-weight:600;
}

/* ---------- Encabezado de módulo con color ---------- */

QWidget#PaginaModulo{
    background:#D9DEE5;
}

QFrame#PanelModulo{
    background:#E8ECF1;
    border:1px solid #B8C2CE;
    border-radius:3px;
}

QFrame#EncabezadoModulo{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F7F9FB, stop:1 #E3E8EE);
    border-bottom:1px solid #C3CCD8;
    border-top-left-radius:3px;
    border-top-right-radius:3px;
}

QLabel#PaginaModuloTitulo{
    color:#0F2740;
    font-size:12.5pt;
    font-weight:700;
}

QLabel#PaginaModuloSubtitulo{
    color:#5A6878;
    font-size:8.5pt;
}

/* ---------- Listas: herramientas, búsqueda y pie ---------- */

QWidget#DataGrid{
    background:transparent;
    border:none;
}

QFrame#BarraHerramientasLista{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F7F9FB, stop:1 #E6EBF1);
    border:1px solid #C3CCD8;
    border-radius:3px;
}

QToolButton#BotonBarraLista,
QToolButton#MaestroToolbarMas{
    background:transparent;
    border:1px solid transparent;
    border-radius:3px;
    color:#1E293B;
    padding:3px 8px;
}

QToolButton#BotonBarraLista:hover,
QToolButton#MaestroToolbarMas:hover{
    background:#FFFFFF;
    border:1px solid #A9B7C8;
}

QFrame#BarraBusquedaLista{
    background:#DDE3EA;
    border:1px solid #C3CCD8;
    border-radius:3px;
}

QLabel#EtiquetaBusqueda{
    color:#1E3A5F;
    font-weight:600;
}

QFrame#PieListado{
    background:#DDE3EA;
    border:1px solid #C3CCD8;
    border-radius:3px;
}

QToolButton#BotonNavegador{
    background:transparent;
    border:1px solid transparent;
    border-radius:2px;
    padding:2px;
}

QToolButton#BotonNavegador:hover{
    background:#FFFFFF;
    border:1px solid #A9B7C8;
}

QLabel#NavegadorPosicion{
    background:#FFFFFF;
    border:1px solid #B8C2CE;
    border-radius:2px;
    color:#1E293B;
    padding:1px 8px;
}

QLabel#DataGridTotal{
    color:#475569;
}

QHeaderView::section{
    background:qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E6EBF1, stop:1 #C9D2DD);
}
