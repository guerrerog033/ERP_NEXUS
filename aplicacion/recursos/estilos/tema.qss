/* ==========================================================
   ERP NEXUS — Tema "Claro sobrio"

   Paleta única (no usar otros colores en el código):

     Fondo general ......... #F3F5F8
     Superficie ............ #FFFFFF
     Superficie alterna .... #F8FAFC   (hover, filas alternas)
     Borde ................. #E2E8F0
     Borde fuerte .......... #CBD5E1
     Texto ................. #1E293B
     Texto secundario ...... #64748B
     Texto tenue ........... #94A3B8
     Primario .............. #1E3A5F   (azul marino)
     Primario hover ........ #2B4C78
     Primario presionado ... #152C49
     Primario suave ........ #EAF0F7   (selección, activo)
     Primario suave borde .. #C9D6E6
     Peligro ............... #B42318   suave #FEF3F2
     Éxito ................. #067647   suave #ECFDF3
     Advertencia ........... #B54708   suave #FFFAEB
   ========================================================== */


/* ==========================================================
   Base
   ========================================================== */

QWidget{
    background-color:transparent;
    color:#1E293B;
    font-family:"Segoe UI";
    font-size:10pt;
}

/*
   Los contenedores son transparentes: así no aparecen parches
   grises dentro de las tarjetas blancas. Solo pintan fondo las
   ventanas de primer nivel y las superficies que lo declaran.
*/
QMainWindow,
QWidget#Dashboard{
    background-color:#F3F5F8;
}

QDialog,
QMessageBox,
QCalendarWidget,
QCalendarWidget QWidget,
QAbstractItemView,
QListView,
QTreeView,
QListWidget{
    background-color:#FFFFFF;
}

QCalendarWidget QToolButton{
    color:#1E293B;
    background:transparent;
    border:none;
    padding:4px 8px;
}

QCalendarWidget QAbstractItemView:enabled{
    selection-background-color:#1E3A5F;
    selection-color:#FFFFFF;
}

QLabel{
    color:#1E293B;
    background:transparent;
}

QToolTip{
    background:#1E293B;
    color:#FFFFFF;
    border:none;
    padding:6px 8px;
    border-radius:4px;
}




/* ==========================================================
   Barra superior
   ========================================================== */

QWidget#BarraSuperior{
    background-color:#FFFFFF;
    border-bottom:1px solid #E2E8F0;
}

QWidget#BarraSuperior QLabel{
    background:transparent;
}

QLabel#BarraSuperiorTitulo{
    color:#1E3A5F;
    font-size:12pt;
    font-weight:700;
    letter-spacing:0.3px;
}

QLabel#BarraSuperiorSubtitulo{
    color:#64748B;
    font-size:9pt;
    padding-right:6px;
}

QLabel#BarraSuperiorEtiqueta{
    color:#94A3B8;
    font-size:9pt;
    padding-right:4px;
}

QLabel#BarraSuperiorFecha{
    color:#1E293B;
    font-size:10pt;
    font-weight:600;
    min-width:72px;
    padding-right:10px;
    border-right:1px solid #E2E8F0;
    margin-right:4px;
}

QFrame#BarraSuperiorSeparador{
    color:#E2E8F0;
    max-width:1px;
    margin:10px 4px;
}

QLineEdit#BarraSuperiorBusqueda{
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:5px 10px;
    color:#1E293B;
    selection-background-color:#C9D6E6;
    min-height:24px;
}

QLineEdit#BarraSuperiorBusqueda:focus{
    background:#FFFFFF;
    border:1px solid #1E3A5F;
}

QToolButton#BarraSuperiorUsuario{
    background:transparent;
    border:1px solid #E2E8F0;
    border-radius:6px;
    color:#1E293B;
    font-weight:600;
    padding:4px 10px;
    min-height:26px;
}

QToolButton#BarraSuperiorUsuario:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QToolButton#BarraSuperiorUsuario::menu-indicator{
    image:none;
}

QToolButton#BarraSuperiorNotificaciones{
    background:transparent;
    border:1px solid #E2E8F0;
    border-radius:6px;
    color:#1E293B;
    padding:4px 10px;
    font-size:9pt;
}

QToolButton#BarraSuperiorNotificaciones:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QLabel#BarraSuperiorBadge{
    background:#B42318;
    color:#FFFFFF;
    border-radius:8px;
    font-size:8pt;
    font-weight:bold;
    min-width:16px;
    max-width:22px;
    min-height:16px;
    padding:0 2px;
}


/* ==========================================================
   Barra lateral
   ========================================================== */

QWidget#BarraLateral{
    background-color:#FFFFFF;
    border:none;
    border-right:1px solid #E2E8F0;
}

QScrollArea#BarraLateralScroll,
QScrollArea#BarraLateralScroll QAbstractScrollArea::viewport,
QWidget#BarraLateralContenedor{
    background-color:#FFFFFF;
    border:none;
}

QScrollArea#BarraLateralScroll QScrollBar:vertical{
    width:6px;
    background:transparent;
    margin:0;
}

QScrollArea#BarraLateralScroll QScrollBar::handle:vertical{
    background:#E2E8F0;
    border-radius:3px;
    min-height:24px;
}

QScrollArea#BarraLateralScroll QScrollBar::handle:vertical:hover{
    background:#CBD5E1;
}

QScrollArea#BarraLateralScroll QScrollBar::add-line:vertical,
QScrollArea#BarraLateralScroll QScrollBar::sub-line:vertical,
QScrollArea#BarraLateralScroll QScrollBar::add-page:vertical,
QScrollArea#BarraLateralScroll QScrollBar::sub-page:vertical{
    height:0;
    background:transparent;
}

QPushButton#BarraLateralToggle{
    background:#FFFFFF;
    color:#64748B;
    border:none;
    border-top:1px solid #E2E8F0;
    border-radius:0;
    padding:8px;
    font-weight:600;
    min-height:30px;
}

QPushButton#BarraLateralToggle:hover{
    background:#F8FAFC;
    color:#1E3A5F;
}

QLabel#BarraLateralEtiqueta{
    color:#94A3B8;
    font-size:8pt;
    font-weight:700;
    letter-spacing:0.8px;
    padding:16px 18px 6px 18px;
    background:transparent;
}

QFrame#BarraLateralSeparador{
    color:#E2E8F0;
    margin:6px 14px;
    max-height:1px;
}

QFrame#BotonModulo,
QFrame#BotonModuloPendiente{
    background:transparent;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QFrame#BotonModulo:hover{
    background-color:#F8FAFC;
}

QFrame#BotonModuloPendiente:hover{
    background-color:#F8FAFC;
}

QFrame#BotonModuloActivo{
    background-color:#EAF0F7;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QLabel#BotonModuloTitulo{
    color:#334155;
    font-size:10pt;
    background:transparent;
}

QFrame#BotonModuloActivo QLabel#BotonModuloTitulo{
    color:#1E3A5F;
    font-weight:600;
}

QFrame#BotonModuloPendiente QLabel#BotonModuloTitulo{
    color:#94A3B8;
}

QLabel#BotonModuloIcono{
    background:transparent;
    min-width:20px;
    min-height:20px;
}

QLabel#BotonModuloFlecha{
    color:#94A3B8;
    background:transparent;
    font-size:9pt;
}

QFrame#BotonModuloActivo QLabel#BotonModuloFlecha{
    color:#1E3A5F;
}

QWidget#BarraLateralSubmenu{
    background:transparent;
    margin:2px 0 6px 0;
}

QFrame#BotonSubmodulo,
QFrame#BotonSubmoduloActivo{
    background:transparent;
    border:none;
    border-radius:6px;
    margin:0 8px;
}

QFrame#BotonSubmodulo:hover{
    background-color:#F8FAFC;
}

QLabel#BotonSubmoduloTitulo{
    color:#64748B;
    font-size:9.5pt;
    background:transparent;
}

QFrame#BotonSubmodulo:hover QLabel#BotonSubmoduloTitulo{
    color:#1E293B;
}

QFrame#BotonSubmoduloActivo QLabel#BotonSubmoduloTitulo{
    color:#1E3A5F;
    font-weight:600;
}


/* ==========================================================
   Buscador de módulos (Ctrl+K)
   ========================================================== */

QDialog#BuscadorModulos{
    background-color:#FFFFFF;
}

QLineEdit#BuscadorModulosEntrada{
    background:#FFFFFF;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:8px 12px;
    font-size:10pt;
    min-height:22px;
}

QLineEdit#BuscadorModulosEntrada:focus{
    border:1px solid #1E3A5F;
}

QLabel#BuscadorModulosAyuda{
    color:#64748B;
    font-size:9pt;
    background:transparent;
}

QListWidget#BuscadorModulosLista{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:4px;
    font-size:10pt;
}

QListWidget#BuscadorModulosLista::item{
    padding:8px 10px;
    border-radius:4px;
}

QListWidget#BuscadorModulosLista::item:selected{
    background-color:#EAF0F7;
    color:#1E3A5F;
}

QListWidget#BuscadorModulosLista::item:hover{
    background-color:#F8FAFC;
}


/* ==========================================================
   Área de trabajo (pestañas)
   ========================================================== */

QTabWidget#AreaTrabajo{
    background-color:#F3F5F8;
}

QTabWidget#AreaTrabajo::pane{
    border:none;
    border-top:1px solid #E2E8F0;
    background-color:#F3F5F8;
    top:-1px;
}

QTabWidget#AreaTrabajo::tab-bar{
    alignment:left;
}

QTabWidget#AreaTrabajo QTabBar{
    background:#FFFFFF;
}

QTabWidget#AreaTrabajo QTabBar::tab{
    background:#FFFFFF;
    border:none;
    border-bottom:2px solid transparent;
    padding:9px 30px 9px 14px;
    margin-right:0;
    min-width:88px;
    color:#64748B;
}

QTabWidget#AreaTrabajo QTabBar::tab:selected{
    color:#1E3A5F;
    font-weight:600;
    border-bottom:2px solid #1E3A5F;
}

QTabWidget#AreaTrabajo QTabBar::tab:hover{
    color:#1E293B;
    background:#F8FAFC;
}

QTabWidget#AreaTrabajo QTabBar::close-button{
    subcontrol-origin:padding;
    subcontrol-position:right;
    width:16px;
    height:16px;
    margin:2px 8px 2px 4px;
    border-radius:3px;
    background:transparent;
}

QTabWidget#AreaTrabajo QTabBar::close-button:hover{
    background:#FEF3F2;
}


/* ==========================================================
   Inicio
   ========================================================== */

QWidget#Inicio{
    background-color:#F3F5F8;
}

QFrame#PanelInicio{
    background-color:#F3F5F8;
    border:none;
}

QLabel#InicioTitulo{
    font-size:18pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#InicioSubtitulo{
    font-size:10pt;
    color:#64748B;
}

QFrame#TarjetaInicio{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    padding:12px;
}

QFrame#TarjetaInicio:hover{
    border-color:#CBD5E1;
}

QLabel#TarjetaInicioTitulo{
    color:#64748B;
    font-size:9pt;
    font-weight:600;
}

QLabel#TarjetaInicioValor{
    font-size:18pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#TarjetaInicioDetalle{
    color:#94A3B8;
    font-size:9pt;
}

QLabel#InicioSeccionTitulo{
    color:#1E293B;
    font-size:10.5pt;
    font-weight:700;
    padding-top:6px;
}

QPushButton#BotonAccesoRapido{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:8px 16px;
    font-weight:600;
    min-height:20px;
}

QPushButton#BotonAccesoRapido:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
    color:#1E3A5F;
}

QFrame#InicioListaRecientes{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QPushButton#InicioFilaReciente{
    background:transparent;
    color:#1E293B;
    border:none;
    border-bottom:1px solid #F1F5F9;
    border-radius:0;
    padding:10px 14px;
    text-align:left;
    font-weight:400;
}

QPushButton#InicioFilaReciente:hover{
    background:#F8FAFC;
}

QPushButton#InicioFilaReciente:last-child{
    border-bottom:none;
}

QLabel#InicioListaVacia{
    color:#94A3B8;
    font-size:9pt;
    padding:12px 14px;
}

QScrollArea#InicioScroll{
    background:transparent;
    border:none;
}


/* ==========================================================
   Páginas de módulo
   ========================================================== */

QWidget#PaginaModulo{
    background:transparent;
}

QFrame#PanelModulo{
    background-color:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QLabel#PaginaModuloTitulo{
    font-size:16pt;
    font-weight:700;
    color:#1E293B;
}

QLabel#PaginaModuloSubtitulo{
    font-size:10pt;
    color:#64748B;
}


/* ==========================================================
   Barra inferior y barra de estado
   ========================================================== */

QWidget#BarraInferior{
    background:#FFFFFF;
    border-top:1px solid #E2E8F0;
}

QFrame#BarraInferiorSeparador{
    color:#E2E8F0;
    max-width:1px;
}

QPushButton#BotonRapido{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:6px 12px;
    font-weight:600;
    color:#1E293B;
    min-height:20px;
}

QPushButton#BotonRapido:hover{
    background:#F8FAFC;
    border-color:#CBD5E1;
}

QPushButton#BotonRapidoDestacado{
    background:#1E3A5F;
    border:1px solid #1E3A5F;
    border-radius:6px;
    padding:6px 14px;
    font-weight:600;
    color:#FFFFFF;
    min-height:22px;
}

QPushButton#BotonRapidoDestacado:hover{
    background:#2B4C78;
}

QWidget#BarraEstado{
    background-color:#FFFFFF;
    border-top:1px solid #E2E8F0;
}

QWidget#BarraEstado QLabel,
QLabel#BarraEstadoTexto{
    color:#64748B;
    font-size:9pt;
    background:transparent;
}

QLabel#BarraEstadoTextoDestacado{
    color:#1E293B;
    font-weight:600;
}


/* ==========================================================
   Maestros — toolbar y grilla
   ========================================================== */

QWidget#ToolbarAcciones{
    background:transparent;
    border:none;
    padding:0;
}

QWidget#DataGrid{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QWidget#DataGridToolbar{
    background:#FFFFFF;
    border:none;
    border-bottom:1px solid #E2E8F0;
    padding:2px 4px;
}

QLabel#DataGridTotal{
    color:#64748B;
    font-size:9pt;
    padding:2px 4px;
}

QWidget#LoadingOverlay{
    background:rgba(243,245,248,0.82);
    border:none;
}

QLabel#LoadingOverlayText{
    color:#1E293B;
    font-size:11pt;
    font-weight:600;
    padding:12px 20px;
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QToolButton#MaestroToolbarMas{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:6px 12px;
    font-weight:600;
}

QToolButton#MaestroToolbarMas:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QToolButton#MaestroToolbarMas::menu-indicator{
    image:none;
}

QWidget#Page{
    background:transparent;
}


/* ==========================================================
   Login
   ========================================================== */

QWidget#Login,
QWidget#LoginContenedor,
QWidget#LoginMarcaPanel,
QStackedWidget,
QStackedWidget#StackPrincipal {
    background: transparent;
}

QFrame#LoginPanel{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:14px;
}

QFrame#LoginPanelCabecera{
    background:#1E3A5F;
    border-top-left-radius:13px;
    border-top-right-radius:13px;
}

QLabel#LoginSubtitulo{
    color:#FFFFFF;
    background:transparent;
    font-size:15pt;
    font-weight:700;
}

QLabel#LoginCabeceraDetalle{
    color:rgba(255,255,255,0.78);
    background:transparent;
    font-size:9pt;
}

QLabel#LoginModuloChip{
    background:#EAF0F7;
    color:#1E3A5F;
    border:1px solid #C9D6E6;
    border-radius:10px;
    padding:4px 8px;
    font-size:8pt;
    font-weight:600;
}

QLabel#LoginMarcaTitulo{
    color:#FFFFFF;
    background:transparent;
    font-size:42px;
    font-weight:700;
}

QLabel#LoginMarcaTexto{
    color:rgba(255,255,255,0.85);
    background:transparent;
    font-size:13pt;
}

QLabel#LoginDestacadoMarca{
    color:#FFFFFF;
    background:rgba(255,255,255,0.10);
    border:1px solid rgba(255,255,255,0.25);
    border-radius:10px;
    padding:4px 10px;
    font-size:8pt;
    font-weight:600;
}


/* ==========================================================
   Formularios
   ========================================================== */

QGroupBox{
    font-weight:600;
    border:1px solid #E2E8F0;
    border-radius:8px;
    margin-top:14px;
    padding-top:14px;
    background:#FFFFFF;
}

QGroupBox#FormGroupBox{
    font-size:10.5pt;
    font-weight:600;
    border:1px solid #E2E8F0;
    border-radius:8px;
    margin-top:14px;
    padding-top:16px;
    background:#FFFFFF;
}

QGroupBox::title{
    subcontrol-origin:margin;
    left:12px;
    padding-left:4px;
    padding-right:4px;
    color:#1E293B;
}

QGroupBox#FormGroupBox::title{
    left:14px;
    padding:0px 4px;
}

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:5px 8px;
    selection-background-color:#C9D6E6;
    selection-color:#1E293B;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover{
    border-color:#94A3B8;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus{
    border:1px solid #1E3A5F;
}

QLineEdit:read-only{
    background:#F8FAFC;
    color:#475569;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled{
    background:#F8FAFC;
    color:#94A3B8;
    border-color:#E2E8F0;
}

QComboBox QAbstractItemView{
    background:#FFFFFF;
    border:1px solid #CBD5E1;
    selection-background-color:#EAF0F7;
    selection-color:#1E3A5F;
    outline:none;
}

QCheckBox{
    background:transparent;
    spacing:8px;
}

QLabel#CampoErrorLabel{
    color:#B42318;
    font-size:9pt;
    padding-left:2px;
}

QLineEdit[invalid="true"],
QComboBox[invalid="true"],
QSpinBox[invalid="true"],
QDoubleSpinBox[invalid="true"]{
    border:1px solid #B42318;
    background:#FEF3F2;
}


/* ==========================================================
   Botones

   Por defecto un botón es secundario (blanco con borde).
   Solo la acción principal de cada pantalla es azul marino
   (#BotonPrimario) y las destructivas van en rojo suave.
   ========================================================== */

QPushButton{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QPushButton:pressed{
    background:#F1F5F9;
}

QPushButton:disabled{
    background:#F8FAFC;
    color:#94A3B8;
    border-color:#E2E8F0;
}

QPushButton#BotonPrimario{
    background:#1E3A5F;
    color:#FFFFFF;
    border:1px solid #1E3A5F;
    border-radius:6px;
    padding:7px 18px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonPrimario:hover{
    background:#2B4C78;
    border-color:#2B4C78;
}

QPushButton#BotonPrimario:pressed{
    background:#152C49;
}

QPushButton#BotonPrimario:disabled{
    background:#CBD5E1;
    border-color:#CBD5E1;
    color:#FFFFFF;
}

QPushButton#BotonSecundario{
    background:#FFFFFF;
    color:#1E293B;
    border:1px solid #CBD5E1;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonSecundario:hover{
    background:#F8FAFC;
    border-color:#94A3B8;
}

QPushButton#BotonSecundario:pressed{
    background:#F1F5F9;
}

QPushButton#BotonPeligro{
    background:#FFFFFF;
    color:#B42318;
    border:1px solid #F3C9C4;
    border-radius:6px;
    padding:7px 16px;
    font-weight:600;
    min-height:18px;
}

QPushButton#BotonPeligro:hover{
    background:#FEF3F2;
    border-color:#B42318;
}

QPushButton#BotonPeligro:pressed{
    background:#FEE4E2;
}


/* ==========================================================
   Vista de documento (facturas, cotizaciones, pedidos...)
   ========================================================== */

QLabel#DocumentoTitulo{
    color:#1E293B;
    font-size:13pt;
    font-weight:700;
}

QLabel#BarraAccionEtiqueta{
    color:#64748B;
    font-weight:600;
}

QLabel#DocumentoFormatoChip{
    color:#64748B;
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:11px;
    padding:3px 12px;
    font-size:9pt;
}

QLabel#DocumentoBadge{
    background:#F8FAFC;
    color:#475569;
    border:1px solid #E2E8F0;
    border-radius:11px;
    padding:3px 12px;
    font-size:9pt;
    font-weight:600;
}

QLabel#DocumentoBadge[tono="info"]{
    background:#EAF0F7;
    color:#1E3A5F;
    border:1px solid #C9D6E6;
}

QLabel#DocumentoBadge[tono="exito"]{
    background:#ECFDF3;
    color:#067647;
    border:1px solid #ABEFC6;
}

QLabel#DocumentoBadge[tono="advertencia"]{
    background:#FFFAEB;
    color:#B54708;
    border:1px solid #FEDF89;
}

QLabel#DocumentoBadge[tono="peligro"]{
    background:#FEF3F2;
    color:#B42318;
    border:1px solid #FECDCA;
}

QFrame#DocumentoPreviewMarco{
    background:#F3F5F8;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QTextBrowser#DocumentoPreviewHtml{
    background:#FFFFFF;
    border-radius:6px;
    padding:8px;
}


/* ==========================================================
   Tablas
   ========================================================== */

QTableWidget,
QTableView{
    background:#FFFFFF;
    alternate-background-color:#F8FAFC;
    gridline-color:#F1F5F9;
    border:1px solid #E2E8F0;
    border-radius:6px;
    selection-background-color:#EAF0F7;
    selection-color:#1E293B;
    outline:none;
}

QTableWidget::item,
QTableView::item{
    padding:4px 6px;
    border:none;
}

QTableWidget::item:selected,
QTableView::item:selected{
    background:#EAF0F7;
    color:#1E293B;
}

QHeaderView{
    background:#F8FAFC;
    border:none;
}

QHeaderView::section{
    background:#F8FAFC;
    color:#475569;
    padding:8px 6px;
    border:none;
    border-bottom:1px solid #E2E8F0;
    border-right:1px solid #F1F5F9;
    font-weight:600;
}

QTableCornerButton::section{
    background:#F8FAFC;
    border:none;
    border-bottom:1px solid #E2E8F0;
}


/* ==========================================================
   Barras de desplazamiento (generales)
   ========================================================== */

QScrollBar:vertical{
    width:10px;
    background:transparent;
    margin:2px;
}

QScrollBar::handle:vertical{
    background:#CBD5E1;
    border-radius:3px;
    min-height:28px;
}

QScrollBar::handle:vertical:hover{
    background:#94A3B8;
}

QScrollBar:horizontal{
    height:10px;
    background:transparent;
    margin:2px;
}

QScrollBar::handle:horizontal{
    background:#CBD5E1;
    border-radius:3px;
    min-width:28px;
}

QScrollBar::handle:horizontal:hover{
    background:#94A3B8;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page{
    width:0;
    height:0;
    background:transparent;
}

QScrollArea{
    background:transparent;
    border:none;
}

QWidget#FormularioPage{
    background:transparent;
}


/* ==========================================================
   Menús y diálogos
   ========================================================== */

QMenu{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:6px;
    padding:4px;
}

QMenu::item{
    padding:6px 18px;
    border-radius:4px;
    background:transparent;
}

QMenu::item:selected{
    background:#EAF0F7;
    color:#1E3A5F;
}

QMenu::separator{
    height:1px;
    background:#E2E8F0;
    margin:4px 6px;
}

QDialog{
    background:#FFFFFF;
}

QMessageBox{
    background:#FFFFFF;
}


/* ==========================================================
   Contabilidad
   ========================================================== */

QWidget#HubContabilidad{
    background:#F3F5F8;
}

QTabWidget::pane{
    border:1px solid #E2E8F0;
    background:#FFFFFF;
    border-radius:6px;
}

QTabBar::tab{
    background:transparent;
    color:#64748B;
    border:none;
    border-bottom:2px solid transparent;
    padding:8px 16px;
}

QTabBar::tab:selected{
    color:#1E3A5F;
    font-weight:600;
    border-bottom:2px solid #1E3A5F;
}

QTabBar::tab:hover{
    color:#1E293B;
}

QTabWidget#ContabilidadTabs::pane{
    border:1px solid #E2E8F0;
    background:#F3F5F8;
    border-radius:0 0 6px 6px;
}

QTabWidget#ContabilidadTabs QTabBar::tab{
    background:transparent;
    color:#64748B;
    border:none;
    border-bottom:2px solid transparent;
    padding:8px 18px;
    margin-right:2px;
    font-weight:600;
}

QTabWidget#ContabilidadTabs QTabBar::tab:selected{
    color:#1E3A5F;
    border-bottom:2px solid #1E3A5F;
}

QFrame#TarjetaProcesoContabilidad{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    min-height:180px;
}

QLabel#TarjetaProcesoContabilidadTitulo{
    color:#1E293B;
    font-size:11pt;
    font-weight:700;
    padding-bottom:4px;
}

QPushButton#EnlaceProcesoContabilidad{
    background:transparent;
    color:#334155;
    border:none;
    text-align:left;
    padding:4px 2px;
    font-size:10pt;
    font-weight:400;
}

QPushButton#EnlaceProcesoContabilidad:hover{
    color:#1E3A5F;
    text-decoration:underline;
}


/* ==========================================================
   Panel gerencial
   ========================================================== */

QWidget#PanelGerencialPage{
    background:#F3F5F8;
}

QLabel#PanelGerencialEmpresa{
    color:#1E293B;
    font-size:12pt;
    font-weight:600;
}

QFrame#PanelGerencialKpi{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    min-height:96px;
}

QFrame#PanelGerencialKpi:hover{
    border-color:#CBD5E1;
}

QLabel#PanelGerencialKpiTitulo{
    color:#64748B;
    font-size:10pt;
    font-weight:600;
}

QLabel#PanelGerencialKpiValor{
    color:#1E293B;
    font-size:16pt;
    font-weight:700;
}

QLabel#PanelGerencialKpiDetalle{
    color:#64748B;
    font-size:9pt;
}

QFrame#PanelGerencialEmbudo{
    background:#FFFFFF;
    border:1px solid #E2E8F0;
    border-radius:8px;
    padding:8px;
}

QLabel#PanelGerencialEmbudoTitulo{
    color:#1E293B;
    font-size:11pt;
    font-weight:700;
    padding-bottom:6px;
}

QProgressBar#PanelGerencialEmbudoBarra{
    border:1px solid #E2E8F0;
    border-radius:4px;
    text-align:left;
    padding-left:8px;
    background:#F8FAFC;
    color:#1E293B;
    min-height:22px;
}

QProgressBar#PanelGerencialEmbudoBarra::chunk{
    background:#1E3A5F;
    border-radius:3px;
}


/* ==========================================================
   Contenedor principal tras iniciar sesión
   ========================================================== */

QWidget#Dashboard{
    background-color:#F3F5F8;
}


/* ==========================================================
   Hoja de documento (cotización, pedido, remisión, factura...)
   ========================================================== */

QLabel#DocumentoTituloHoja{
    color:#1E293B;
    font-size:17pt;
    font-weight:700;
    padding:0 0 6px 0;
    border:none;
}

QFrame#DocumentoSeparador{
    color:#E2E8F0;
    background:#E2E8F0;
    max-height:1px;
    border:none;
}

QLabel#DocumentoEtiquetaSeccion{
    color:#1E293B;
    font-weight:600;
}

QPushButton#BotonAgregarLinea{
    background:transparent;
    color:#1E3A5F;
    border:1px dashed #C9D6E6;
    border-radius:6px;
    padding:7px 14px;
    font-weight:600;
}

QPushButton#BotonAgregarLinea:hover{
    background:#EAF0F7;
    border-color:#1E3A5F;
}

QWidget#PanelTotalesDocumento{
    background:#F8FAFC;
    border:1px solid #E2E8F0;
    border-radius:8px;
}

QWidget#PanelTotalesDocumento QLabel{
    color:#475569;
}

QLabel#DocumentoTotal{
    color:#1E293B;
    font-size:13pt;
    font-weight:700;
    padding-top:6px;
    border-top:1px solid #E2E8F0;
}


/* ==========================================================
   Flechas de combos, fechas y números
   ========================================================== */

QComboBox,
QDateEdit{
    padding-right:24px;
}

QComboBox::drop-down,
QDateEdit::drop-down{
    subcontrol-origin:padding;
    subcontrol-position:center right;
    width:22px;
    border:none;
    background:transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow{
    image:url({ICONOS}/flecha_abajo.svg);
    width:12px;
    height:12px;
}

QComboBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled{
    image:none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button{
    subcontrol-origin:border;
    subcontrol-position:top right;
    width:18px;
    border:none;
    background:transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button{
    subcontrol-origin:border;
    subcontrol-position:bottom right;
    width:18px;
    border:none;
    background:transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow{
    image:url({ICONOS}/flecha_arriba.svg);
    width:10px;
    height:10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow{
    image:url({ICONOS}/flecha_abajo.svg);
    width:10px;
    height:10px;
}


/* ==========================================================
   Casillas de verificación y opciones
   ========================================================== */

QCheckBox::indicator,
QTableView::indicator,
QTableWidget::indicator{
    width:16px;
    height:16px;
    border:1px solid #94A3B8;
    border-radius:4px;
    background:#FFFFFF;
}

QCheckBox::indicator:hover{
    border-color:#1E3A5F;
}

QCheckBox::indicator:checked,
QTableView::indicator:checked,
QTableWidget::indicator:checked{
    background:#1E3A5F;
    border-color:#1E3A5F;
    image:url({ICONOS}/check.svg);
}

QCheckBox::indicator:disabled{
    background:#F1F5F9;
    border-color:#CBD5E1;
}

QRadioButton::indicator{
    width:16px;
    height:16px;
    border:1px solid #94A3B8;
    border-radius:8px;
    background:#FFFFFF;
}

QRadioButton::indicator:checked{
    border:5px solid #1E3A5F;
    background:#FFFFFF;
}
